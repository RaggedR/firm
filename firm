#!/bin/sh
# firm — the CLI. Needs the servers up (./up.sh). It may reach the CEO and
# nothing else: a client cannot go round the back of the agent it is asking.
cd "$(dirname "$0")"
exec deno run --quiet \
  --allow-net=127.0.0.1:8841,localhost:8841 \
  --allow-run=deno --allow-read=. --allow-env firm-cli.ts "$@"
